# Copy to deploy/.env on the server and adjust as needed.
HEAL_VIEW_IMAGE=ghcr.io/crazystudent13/heal-view:latest
HEAL_VIEW_PORT=43128
HEAL_VIEW_DATA_DIR=./deploy/data
HEAL_VIEW_UPLOAD_DIR=./deploy/uploads
AUTH_SESSION_TTL=604800
AUTH_COOKIE_NAME=heal_view_session
AUTH_COOKIE_SECURE=true
CACHE_TTL_DATES=86400
CACHE_TTL_SUMMARY=3600
# Leave empty for same-origin access (the default). Only set when an external
# origin really has to call /api, e.g. "*" or "https://a.example.com".
CORS_ORIGIN=
