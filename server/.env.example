# Server port
PORT=43128
NODE_ENV=production
AUTH_COOKIE_SECURE=true
# Keep these under a mounted volume when running in Docker.
DATA_DIR=./data
DB_PATH=./health_data.db
UPLOAD_DIR=./uploads

# Cache TTL in seconds
CACHE_TTL_DATES=86400
CACHE_TTL_SUMMARY=3600

# Leave empty for same-origin access (the default and the recommended setup).
# Only set this when an external origin really has to call /api, e.g. "*" or
# "https://a.example.com,https://b.example.com".
CORS_ORIGIN=
